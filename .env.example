DATABASE_URL="postgresql://user:password@your-neon-host-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://user:password@your-neon-host.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"
GROQ_API_KEY="your-groq-api-key-here"
# Optional: a second, independent Groq account for quota failover (see
# lib/aiScoring.js) - falls back to rule-based scoring if unset.
GROQ_API_KEY_SECONDARY="your-secondary-groq-api-key-here"
# Optional: third failover tier behind both Groq keys (see
# lib/geminiScoring.js) - falls back to rule-based scoring if unset.
GEMINI_API_KEY="your-gemini-api-key-here"
RAZORPAY_KEY_ID="your-razorpay-key-id-here"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret-here"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret-here"
SESSION_SECRET="random-hex-string-for-signing-session-cookies"
RESEND_API_KEY="your-resend-api-key-here"
