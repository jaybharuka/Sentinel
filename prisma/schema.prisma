// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Merchant {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  settings     MerchantSettings?
  transactions Transaction[]
  alerts       Alert[]
}

model Transaction {
  id             Int      @id @default(autoincrement())
  merchantId     String
  merchant       Merchant @relation(fields: [merchantId], references: [id])
  txnId          String   @unique
  amount         Float
  email          String
  ipCountry      String
  billingCountry String
  timestamp      DateTime @default(now())

  features       Json
  riskScore      Float?
  confidence     Float?
  reasons        Json?
  usedFallback   Boolean  @default(false)
  policyDecision String?
  actionTaken    String?
  humanOverride  Boolean  @default(false)
  overrideReason String?
  overriddenAt   DateTime?
  isLabeledFraud Boolean?
  source         String   @default("synthetic")
  disputedAt     DateTime?
  refundExecuted Boolean?
  refundId       String?
  refundError    String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  alerts         Alert[]
}

model Alert {
  id            Int      @id @default(autoincrement())
  merchantId    String
  merchant      Merchant @relation(fields: [merchantId], references: [id])
  transactionId Int
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  sentTo        String
  subject       String
  body          String
  emailSent     Boolean  @default(false)
  emailError    String?
  createdAt     DateTime @default(now())
}

model MerchantSettings {
  id                        Int      @id @default(autoincrement())
  merchantId                String   @unique
  merchant                  Merchant @relation(fields: [merchantId], references: [id])
  autoRefundMaxAmount       Int      @default(2000)
  dailyRefundCap            Int      @default(10000)
  autoRefundMinRiskScore    Float    @default(0.9)
  autoRefundMinConfidence   Float    @default(0.8)
  holdForReviewMinRiskScore Float    @default(0.6)
  alertEmail                String?
  apiKey                    String?  @unique

  updatedAt                 DateTime @updatedAt
}
