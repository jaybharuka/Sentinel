// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Merchant {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  emailVerified            Boolean   @default(false)
  verificationToken        String?   @unique
  verificationTokenExpiry  DateTime?
  resetToken               String?   @unique
  resetTokenExpiry         DateTime?

  settings     MerchantSettings?
  transactions Transaction[]
  alerts       Alert[]
  sessions     Session[]
}

// A real server-side session record, not just a signed JWT - the JWT
// (lib/session.js) carries this row's id alongside merchantId, and every
// Node-side auth check (getCurrentMerchant(), ultimately) confirms the row
// still exists and hasn't expired before trusting the token. That's what
// makes "log out this device" or "revoke a session" actually work: deleting
// this row makes a copy of that JWT stop authenticating immediately,
// everywhere, not just on the device that logged out. middleware.js still
// only checks the JWT's signature/expiry at the edge (Prisma can't run
// there) - same architectural split it already had for "does this merchant
// row still exist," not a new gap.
model Session {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id])
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  userAgent  String?
  expiresAt  DateTime
}

model Transaction {
  id             Int      @id @default(autoincrement())
  merchantId     String
  merchant       Merchant @relation(fields: [merchantId], references: [id])
  txnId          String   @unique
  amount         Float
  email          String
  ipCountry      String
  billingCountry String
  timestamp      DateTime @default(now())

  features       Json
  riskScore      Float?
  confidence     Float?
  reasons        Json?
  usedFallback   Boolean  @default(false)
  provider       String?
  scoringLatencyMs Int?
  policyDecision String?
  actionTaken    String?
  humanOverride  Boolean  @default(false)
  overrideReason String?
  overriddenAt   DateTime?
  // Set when a merchant looks at a flagged transaction in the Review Queue
  // and decides the original decision should stand - a lighter-weight
  // acknowledgment than humanOverride, which actually reverses the
  // decision. Both reviewedAt and humanOverride remove a transaction from
  // the Review Queue (see app/api/review-queue/route.js); only
  // humanOverride changes actionTaken. Nullable/independent of
  // overriddenAt so the two "this no longer needs my attention" paths
  // (kept vs. reversed) stay distinguishable in the audit trail.
  reviewedAt     DateTime?
  isLabeledFraud Boolean?
  source         String   @default("synthetic")
  disputedAt     DateTime?
  refundExecuted Boolean?
  refundId       String?
  refundError    String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  alerts         Alert[]
}

model Alert {
  id            Int      @id @default(autoincrement())
  merchantId    String
  merchant      Merchant @relation(fields: [merchantId], references: [id])
  transactionId Int
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  sentTo        String
  subject       String
  body          String
  emailSent     Boolean  @default(false)
  emailError    String?
  createdAt     DateTime @default(now())
}

// Webhook idempotency, replacing reliance on Transaction.txnId's unique
// constraint as an accidental (and incomplete) safety net - that constraint
// only ever prevented a duplicate delivery from creating a second row; it
// did nothing to short-circuit re-running scoring/refund logic before
// hitting it, and gave no visibility into how often Razorpay actually
// redelivers. razorpayEventId is Razorpay's own X-Razorpay-Event-Id header
// when present, or - since real captured payloads confirmed the JSON body
// itself carries no dedicated event id field, only entity/account_id/
// event/contains/payload/created_at - a deterministic hash of stable
// payload content as a fallback, so redeliveries of the same logical event
// still collide on the same key even without that header.
model WebhookEvent {
  id              Int       @id @default(autoincrement())
  razorpayEventId String    @unique
  merchantId      String?
  eventType       String
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?
  status          String    @default("received")
}

model MerchantSettings {
  id                        Int      @id @default(autoincrement())
  merchantId                String   @unique
  merchant                  Merchant @relation(fields: [merchantId], references: [id])
  autoRefundMaxAmount       Int      @default(2000)
  dailyRefundCap            Int      @default(10000)
  autoRefundMinRiskScore    Float    @default(0.9)
  autoRefundMinConfidence   Float    @default(0.8)
  holdForReviewMinRiskScore Float    @default(0.6)
  alertEmail                String?
  // API keys are already high-entropy random strings, not user-chosen
  // passwords - a fast SHA-256 hash is appropriate here (bcrypt's
  // deliberately-slow cost isn't needed and would add real latency to
  // every external API request). apiKeyPrefix is the first 16 characters
  // of the real key ("sk_live_" + 8 hex chars) for display and for
  // narrowing the auth lookup before the actual constant-time hash
  // comparison - see app/api/v1/transactions/route.js. The full key is
  // never stored anywhere; it exists only in the one response that
  // generates it (see lib/merchantSettings.js's regenerateApiKey()).
  apiKeyHash                String?  @unique
  apiKeyPrefix              String?

  updatedAt                 DateTime @updatedAt
}
